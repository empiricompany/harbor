{
  "name": "empiricompany/harbor",
  "description": "Docker-based local development environment and CLI for Maho Commerce applications, orchestrating development runtimes and services.",
  "license": "MIT",
  "type": "maho-module",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "*",
    "mahocommerce/maho": "*",
    "mahocommerce/maho-phpstan-plugin": "*",
    "phpstan/phpstan": "*",
    "phpstan/phpstan-deprecation-rules": "*",
    "phpstan/phpstan-strict-rules": "*",
    "rector/rector": "*"
  },
  "autoload": {
    "psr-4": {
      "MahoCLI\\": "lib/MahoCLI/"
    },
    "classmap": [
      "lib/MahoCLI/Commands/DbExport.php",
      "lib/MahoCLI/Commands/DbImport.php"
    ]
  },
  "config": {
    "allow-plugins": {
      "mahocommerce/maho-composer-plugin": true
    },
    "platform": {
      "php": "8.3"
    }
  },
  "scripts": {
    "test": "bash tests/harbor.sh",
    "lint": "if command -v shellcheck >/dev/null; then shellcheck bin/harbor tests/harbor.sh; else echo 'shellcheck is not installed'; fi",
    "format": "if command -v shfmt >/dev/null; then shfmt -w bin/harbor tests/harbor.sh; else echo 'shfmt is not installed'; fi",
    "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff",
    "cs-fix": "vendor/bin/php-cs-fixer fix",
    "phpstan": "vendor/bin/phpstan analyse",
    "rector": "vendor/bin/rector --dry-run",
    "check": [
      "@test",
      "@cs",
      "@phpstan",
      "@rector"
    ]
  },
  "bin": [
    "bin/harbor"
  ]
}
