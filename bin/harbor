#!/usr/bin/env bash

# Harbor is deliberately a thin Bash adapter around Docker Compose.  Keep
# argument handling here explicit: after a wrapper consumes its own options,
# the remaining arguments are passed as an array and never re-parsed.
set -Eeuo pipefail

fail() {
	printf 'Harbor: %s\n' "$*" >&2
	exit 1
}

usage_error() {
	printf 'Harbor: %s\n' "$*" >&2
	exit 2
}

resolve_package_root() {
	CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd
}

PACKAGE_ROOT=$(resolve_package_root)
PROJECT_ROOT=$(pwd)
HARBOR_DIR=.harbor
ENV_FILE=$HARBOR_DIR/.env
COMPOSE_FILE=.harbor/compose.yaml

[ -d "$PROJECT_ROOT" ] || fail "project root does not exist: $PROJECT_ROOT"
cd "$PROJECT_ROOT" || fail "unable to access project root: $PROJECT_ROOT"

env_value() {
	local key=$1
	sed -n "s/^${key}=//p" "$ENV_FILE" | head -n1
}

AVAILABLE_PROFILES=(redis adminer phpmyadmin)

profile_is_available() {
	local candidate=$1 profile
	for profile in "${AVAILABLE_PROFILES[@]}"; do
		[ "$candidate" = "$profile" ] && return 0
	done
	return 1
}

profile_list() {
	local value=${1:-} profile
	IFS=',' read -r -a profiles <<<"$value"
	for profile in "${profiles[@]}"; do
		[ -n "$profile" ] && printf '%s\n' "$profile"
	done
}

profile_enabled() {
	local candidate=$1 profile
	while IFS= read -r profile; do
		[ "$profile" = "$candidate" ] && return 0
	done < <(profile_list "$(env_value HARBOR_PROFILES)")
	return 1
}

write_profiles() {
	local new_value=$1 tmp
	tmp=$(mktemp "$ENV_FILE.XXXXXX") || fail 'unable to create temporary .env file'
	awk -v value="$new_value" '
		BEGIN { replaced = 0 }
		/^HARBOR_PROFILES=/ {
			if (!replaced) { print "HARBOR_PROFILES=" value; replaced = 1 }
			next
		}
		/^[[:space:]]*#[[:space:]]*HARBOR_PROFILES=/ {
			if (!replaced) { print "HARBOR_PROFILES=" value; replaced = 1 }
			next
		}
		{ print }
		END { if (!replaced) print "HARBOR_PROFILES=" value }
	' "$ENV_FILE" >"$tmp" || {
		rm -f "$tmp"
		fail 'unable to update .harbor/.env'
	}
	cat "$tmp" >"$ENV_FILE" || {
		rm -f "$tmp"
		fail 'unable to update .harbor/.env'
	}
	rm -f "$tmp"
}

set_profile() {
	local action=$1 requested=$2 value profile found=0 result=()
	profile_is_available "$requested" || fail "unknown service '$requested' (available: ${AVAILABLE_PROFILES[*]})"
	value=$(env_value HARBOR_PROFILES)
	while IFS= read -r profile; do
		[ -n "$profile" ] || continue
		if [ "$action" = add ] && [ "$profile" = "$requested" ]; then found=1; fi
		if [ "$action" = remove ] && [ "$profile" = "$requested" ]; then continue; fi
		case " ${result[*]} " in *" $profile "*) ;; *) result+=("$profile") ;; esac
	done < <(profile_list "$value")
	[ "$action" = add ] && [ "$found" -eq 0 ] && result+=("$requested")
	write_profiles "$(
		IFS=,
		echo "${result[*]}"
	)"
}

services_command() {
	local action=${1:-list} service
	shift || true
	case "$action" in
	list)
		[ "$#" -eq 0 ] || usage_error 'services list does not accept arguments'
		echo 'Available profiles:'
		printf '  %s\n' "${AVAILABLE_PROFILES[@]}"
		echo 'Active profiles:'
		profile_list "$(env_value HARBOR_PROFILES)" | sed 's/^/  /'
		;;
	add | remove)
		[ "$#" -eq 1 ] || usage_error "services $action requires a service name"
		service=$1
		set_profile "$action" "$service"
		;;
	*) fail 'usage: harbor services {list|add|remove}' ;;
	esac
}

compose_command() {
	command -v docker >/dev/null 2>&1 || fail "Docker CLI is not available; install Docker and ensure 'docker' is on PATH"
	if docker compose version >/dev/null 2>&1; then
		printf '%s\n' 'plugin'
	elif command -v docker-compose >/dev/null 2>&1; then
		printf '%s\n' 'standalone'
	else
		fail 'Docker Compose is not available; install the Docker Compose plugin or docker-compose'
	fi
}

build_service_compose_args() {
	local service stub
	for service in app db mailpit cron; do
		stub=""
		[ -f "$HARBOR_DIR/stubs/$service.yaml" ] && stub="$HARBOR_DIR/stubs/$service.yaml"
		[ -n "$stub" ] || stub="$PACKAGE_ROOT/resources/stubs/$service.yaml"
		[ -f "$stub" ] || fail "missing service stub: $stub"
		COMPOSE_ARGS+=(-f "$stub")
	done
}

build_compose_args() {
	local project_name profiles_value profile stub
	project_name=${HARBOR_PROJECT_NAME:-$(env_value HARBOR_PROJECT_NAME)}
	project_name=${project_name:-harbor}
	profiles_value=${HARBOR_PROFILES:-$(env_value HARBOR_PROFILES)}
	COMPOSE_ARGS=(
		--env-file .harbor/.env
		-p "$project_name"
		-f .harbor/compose.yaml
	)
	build_service_compose_args

	for profile in redis adminer phpmyadmin; do
		stub=""
		[ -f "$HARBOR_DIR/stubs/$profile.yaml" ] && stub="$HARBOR_DIR/stubs/$profile.yaml"
		[ -n "$stub" ] || stub="$PACKAGE_ROOT/resources/stubs/$profile.yaml"
		[ -f "$stub" ] || fail "missing service stub: $stub"
		COMPOSE_ARGS+=(-f "$stub")
	done

	profiles=()
	if [ -n "$profiles_value" ]; then
		IFS=',' read -r -a profiles <<<"$profiles_value"
		for profile in "${profiles[@]}"; do
			[ -n "$profile" ] || continue
			profile_is_available "$profile" || fail "unknown active profile '$profile'"
		done
	fi

	[ -f "$HARBOR_DIR/docker.override.yaml" ] && COMPOSE_ARGS+=(
		-f "$HARBOR_DIR/docker.override.yaml"
	)
	[ -f "$HARBOR_DIR/docker.install.yaml" ] && COMPOSE_ARGS+=(
		-f "$HARBOR_DIR/docker.install.yaml"
	)

	if [ -n "$profiles_value" ]; then
		for profile in "${profiles[@]}"; do
			[ -n "$profile" ] || continue
			COMPOSE_ARGS+=(--profile "$profile")
		done
	fi
}

compose() {
	local implementation
	implementation=$(compose_command)

	if [ "$implementation" = plugin ]; then
		docker compose "${COMPOSE_ARGS[@]}" "$@"
	else
		docker-compose "${COMPOSE_ARGS[@]}" "$@"
	fi
}

require_configuration() {
	if [ ! -f "$ENV_FILE" ] || [ ! -f "$COMPOSE_FILE" ]; then
		fail 'configuration is missing; run ./vendor/bin/harbor init from the project root'
	fi
}

init_project() {
	local force=0
	[ "${1:-}" = --force ] || [ "${1:-}" = -f ] && force=1
	[ "$#" -le 1 ] || usage_error 'usage: harbor init [--force]'
	mkdir -p "$HARBOR_DIR"
	if [ "$force" -eq 1 ]; then
		cp "$PACKAGE_ROOT/resources/env.example" "$HARBOR_DIR/.env.example"
		cp "$PACKAGE_ROOT/resources/env.example" "$ENV_FILE"
		cp "$PACKAGE_ROOT/resources/harbor.gitignore" "$HARBOR_DIR/.gitignore"
		printf 'services: {}\n' >"$HARBOR_DIR/docker.override.yaml"
		printf 'services: {}\n' >"$HARBOR_DIR/docker.install.yaml"
		cp "$PACKAGE_ROOT/resources/stubs/compose.stub" "$COMPOSE_FILE"
	else
		[ -e "$HARBOR_DIR/.env.example" ] || cp "$PACKAGE_ROOT/resources/env.example" "$HARBOR_DIR/.env.example"
		[ -e "$ENV_FILE" ] || cp "$PACKAGE_ROOT/resources/env.example" "$ENV_FILE"
		[ -e "$HARBOR_DIR/.gitignore" ] || cp "$PACKAGE_ROOT/resources/harbor.gitignore" "$HARBOR_DIR/.gitignore"
		[ -e "$HARBOR_DIR/docker.override.yaml" ] || printf 'services: {}\n' >"$HARBOR_DIR/docker.override.yaml"
		[ -e "$HARBOR_DIR/docker.install.yaml" ] || printf 'services: {}\n' >"$HARBOR_DIR/docker.install.yaml"
		if [ -e "$COMPOSE_FILE" ]; then
			fail "$COMPOSE_FILE already exists (use --force to replace it)"
		fi
		cp "$PACKAGE_ROOT/resources/stubs/compose.stub" "$COMPOSE_FILE"
	fi
}

maho_scaffold() { "$PROJECT_ROOT/maho" "$@"; }

show_help() {
	cat <<'EOF'
Harbor - Maho local development environment

Usage: ./vendor/bin/harbor <command> [arguments]

Getting started:
	./vendor/bin/harbor init       Create .harbor files and .harbor/compose.yaml
  # Review and adjust .harbor/.env
  ./vendor/bin/harbor up -d      Start the Maho development stack
  ./vendor/bin/harbor doctor      Check Docker, Compose, configuration, and services

Examples:
  ./vendor/bin/harbor php -v
  ./vendor/bin/harbor composer install
  ./vendor/bin/harbor maho cache:flush
  ./vendor/bin/harbor bin phpunit
  ./vendor/bin/harbor shell

Lifecycle:
  up [options]       Create and start the stack (-d, --build, [services])
  down [options]     Stop and remove the stack (-v, --remove-orphans)
  stop [services]    Stop containers without removing them
  restart [services] Restart selected containers
  ps [services]      Show container status
  logs [service]     Show logs (-f, --tail N, and other Compose options)
  build [services]   Build or rebuild service images
  config             Render the merged Compose configuration

Container tools:
  php                Run PHP in the app container
  composer           Run Composer in the app container
  maho               Run the Maho CLI in the app container
  bin <tool>         Run a vendor/bin executable in app (example: bin phpunit)
  mysql              Run MySQL with configured credentials
  redis              Run redis-cli in the Redis container
  shell [options]    Open Bash; supports -s/--service
  root-shell         Open a root Bash shell in app
  exec [options]     Run a command (--service, --user, --no-tty)
  debug              Run PHP with Xdebug enabled when available
  test               Run PHPUnit through vendor/bin/phpunit
  phpunit            Alias for test
  phpstan            Run PHPStan through vendor/bin/phpstan

Project tools:
  init               Create .harbor files and .harbor/compose.yaml from compose.stub
  doctor             Check Docker, Compose, configuration, and services
  open [target]      Open app, admin, or mailpit (default: app)
  services <action>  List or change optional Compose profiles
  devcontainer       Generate Dev Container configuration (--force to replace)

Options:
  -h, --help         Show this help

Run commands from the Maho project root. Custom services and jobs belong in
.harbor/docker.override.yaml or .harbor/docker.install.yaml.
Unknown commands are delegated to Docker Compose unchanged.
EOF
}

app_exec() {
	compose exec "${TTY_ARGS[@]}" app "$@"
}

service_exec() {
	local service=$1
	shift
	compose exec -T "$service" "$@"
}

doctor() {
	local failed=0

	command -v docker >/dev/null 2>&1 || {
		echo 'FAIL: docker'
		failed=1
	}
	docker info >/dev/null 2>&1 || {
		echo 'FAIL: Docker daemon'
		failed=1
	}
	require_configuration 2>/dev/null || {
		echo 'FAIL: .harbor configuration'
		failed=1
	}

	[ "$failed" -eq 0 ] || return 1
	compose config --quiet || return
	echo 'OK: Docker Compose is configured'
	compose ps
}

[ "${1:-}" = help ] || [ "${1:-}" = --help ] || [ "${1:-}" = -h ] && {
	show_help
	exit 0
}

[ "$#" -gt 0 ] || {
	show_help
	exit 0
}

[ "${1:-}" = init ] && {
	shift
	init_project "$@"
	exit $?
}

[ "${1:-}" = services ] && {
	shift
	[ -f "$ENV_FILE" ] || fail 'configuration is missing; run ./vendor/bin/harbor init from the project root'
	services_command "$@"
	exit $?
}

require_configuration
command -v docker >/dev/null 2>&1 || fail "Docker CLI is not available; install Docker and ensure 'docker' is on PATH"
build_compose_args

TTY_ARGS=()
[ -t 0 ] || TTY_ARGS+=(-T)

command=$1
case "$command" in
up)
	shift
	compose up "$@"
	;;
stop | restart | ps | logs | build | config | start)
	shift
	compose "$command" "$@"
	;;
down)
	shift
	# Include disabled profile services so they can be removed as orphans.
	COMPOSE_ARGS+=(--profile '*')
	compose down --remove-orphans "$@"
	;;
php | composer)
	shift
	app_exec "$command" "$@"
	;;
maho)
	shift
	app_exec php maho "$@"
	;;
bin)
	shift
	[ "$#" -gt 0 ] || usage_error 'bin requires a tool (example: ./vendor/bin/harbor bin phpunit)'
	tool=$1
	shift
	app_exec "./vendor/bin/$tool" "$@"
	;;
test | phpunit)
	shift
	app_exec php vendor/bin/phpunit "$@"
	;;
phpstan)
	shift
	app_exec php vendor/bin/phpstan "$@"
	;;
debug)
	shift
	if compose exec -T app php -r 'exit(extension_loaded("xdebug") ? 0 : 1);' >/dev/null 2>&1; then
		app_exec php -d xdebug.start_with_request=yes "$@"
	else
		printf 'Xdebug is not installed; running PHP without Xdebug support.\n' >&2
		app_exec php "$@"
	fi
	;;
mysql)
	shift
	HARBOR_DB_PASSWORD=$(sed -n 's/^HARBOR_DB_PASSWORD=//p' "$ENV_FILE" | head -n1)
	[ -n "$HARBOR_DB_PASSWORD" ] || fail 'HARBOR_DB_PASSWORD is not configured'
	compose exec -T -e "MYSQL_PWD=$HARBOR_DB_PASSWORD" db mysql \
		--protocol=tcp \
		--host="${HARBOR_DB_HOST:-db}" \
		--user="${HARBOR_DB_USER:-maho}" "$@"
	;;
redis)
	shift
	service_exec redis redis-cli "$@"
	;;
shell)
	shift
	service=app
	if [ "${1:-}" = --service ] || [ "${1:-}" = -s ]; then
		[ "$#" -ge 2 ] || usage_error '--service requires a value (example: ./vendor/bin/harbor shell --service app)'
		service=$2
		shift 2
	fi
	compose exec "${TTY_ARGS[@]}" "$service" bash "$@"
	;;
root-shell)
	shift
	if [ "$#" -eq 0 ]; then
		compose exec "${TTY_ARGS[@]}" -u root app bash
	else
		compose exec "${TTY_ARGS[@]}" -u root app bash -c "$*"
	fi
	;;
exec)
	shift
	service=app
	user_args=()
	exec_args=()
	while [ "$#" -gt 0 ]; do
		case "$1" in
		--service | -s)
			[ "$#" -ge 2 ] || usage_error "$1 requires a value (example: ./vendor/bin/harbor exec --service app id)"
			service=$2
			shift 2
			;;
		--user | -u)
			[ "$#" -ge 2 ] || usage_error "$1 requires a value (example: ./vendor/bin/harbor exec --user www-data id)"
			user_args=(-u "$2")
			shift 2
			;;
		--no-tty)
			exec_args+=(-T)
			shift
			;;
		*) break ;;
		esac
	done
	[ "$#" -gt 0 ] || usage_error 'exec requires a command (example: ./vendor/bin/harbor exec php -v)'
	[ "${#exec_args[@]}" -gt 0 ] || exec_args=("${TTY_ARGS[@]}")
	compose exec "${exec_args[@]}" "${user_args[@]}" "$service" "$@"
	;;
services)
	fail 'services must be handled before runtime configuration'
	;;
doctor)
	shift
	doctor "$@"
	;;
open)
	shift
	target=${1:-app}
	case "$target" in
	app) url=$(grep '^HARBOR_APP_URL=' "$ENV_FILE" | cut -d= -f2-) ;;
	admin) url="$(grep '^HARBOR_APP_URL=' "$ENV_FILE" | cut -d= -f2-)/admin" ;;
	mailpit) url="http://localhost:${HARBOR_MAILPIT_PORT:-8025}" ;;
	*) fail 'usage: harbor open [app|admin|mailpit]' ;;
	esac
	if command -v xdg-open >/dev/null 2>&1; then
		xdg-open "$url"
	elif command -v open >/dev/null 2>&1; then
		open "$url"
	else fail 'no opener available (xdg-open/open)'; fi
	;;
devcontainer)
	force=0
	[ "${2:-}" = --force ] && force=1
	mkdir -p .devcontainer
	[ ! -e .devcontainer/devcontainer.json ] || [ "$force" -eq 1 ] || fail \
		'.devcontainer/devcontainer.json already exists (use --force to replace it)'
	cp "$PACKAGE_ROOT/resources/devcontainer/devcontainer.json" \
		.devcontainer/devcontainer.json
	;;
cron)
	shift
	compose up -d cron "$@"
	;;
*)
	# Unknown commands are intentionally delegated to Compose
	compose "$@"
	;;
esac
