HARBOR_PROJECT_NAME=harbor
HARBOR_APP_PORT=8443
HARBOR_APP_URL=https://localhost:8443/
HARBOR_DB_HOST=db
HARBOR_DB_PORT=3306
HARBOR_DB_NAME=maho
HARBOR_DB_ENGINE=mysql
HARBOR_DB_USER=maho
HARBOR_DB_PASSWORD=maho
HARBOR_DB_ROOT_PASSWORD=root
HARBOR_MYSQL_PORT=3306
HARBOR_UID=1000
HARBOR_GID=1000
HARBOR_PHP_VERSION=8.4
HARBOR_DEBIAN_VARIANT=trixie
# Node.js version used by the Harbor application image.
HARBOR_NODE_VERSION=22.14.0
# Redis connection settings are used when the redis profile is enabled.
HARBOR_REDIS_HOST=redis
HARBOR_REDIS_PORT=6379
HARBOR_REDIS_SESSION_DB=1
HARBOR_REDIS_CACHE_DB=2
# Add optional PHP extensions here. Core Maho extensions and Xdebug are built in.
HARBOR_PHP_EXTENSIONS=""
# Xdebug mode: off (default) | develop | debug | debug,develop,coverage
HARBOR_XDEBUG_MODE=off
# Xdebug client host (where the IDE listens). Default host.docker.internal works on
# most platforms; on Docker Desktop for Linux set it to 192.168.65.254 if Xdebug
# logs "Network is unreachable".
# HARBOR_XDEBUG_CLIENT_HOST=host.docker.internal

# Optional services, comma-separated. Leave commented to run only the default stack.
# Available profiles: redis, adminer, phpmyadmin, cloudflared, cloudflared-quick.
# HARBOR_PROFILES=

# Adminer (host port, default 8082) and phpMyAdmin (host port, default 8081).
# Both point at the Maho DB via HARBOR_DB_*; phpMyAdmin auto-logs in, Adminer
# pre-fills only the server field (the image supports just ADMINER_DEFAULT_SERVER).
# HARBOR_ADMINER_PORT=8082
# HARBOR_PHPMYADMIN_PORT=8081

# Cloudflare Tunnel (named). HARBOR_CLOUDFLARED_TOKEN is the tunnel token from
# the Cloudflare dashboard; HARBOR_CLOUDFLARED_HOSTNAME is the public fixed domain.
# HARBOR_CLOUDFLARED_TOKEN=
# HARBOR_CLOUDFLARED_HOSTNAME=maho.example.com
