# Maho site block for FrankenPHP, for Maho 26.7 and later. It replaces the
# Caddyfile of the dunglas/frankenphp base image, which serves a plain PHP
# application and would send every /api/* path to index.php.
#
# Keep in sync with public/.htaccess in Maho, which is the reference
# implementation, and with https://mahocommerce.com/hosting/web-server/
# See "Caddyfile Templates" in AGENTS.md before editing this file in place.
{
	# The https:// site address in SERVER_NAME makes Caddy generate a local
	# certificate. `skip_install_trust` keeps the container from changing the
	# host trust store; clients must use curl -k or trust the exported CA.
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	root {$SERVER_ROOT:public/}
	encode zstd br gzip

	header X-Content-Type-Options "nosniff"

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Caddy sorts directives by type, not by source order, and the rewrites
	# below depend on each other. A route block runs them in source order.
	# Go regular expressions have no lookaround, so every exception to a
	# match below is a separate `not` line.
	route {
		# Infrastructure-only readiness endpoint. Keep this before the hidden
		# path rule and do not pass it to Maho: an empty database or application
		# error must not make the Caddy/FrankenPHP container unhealthy.
		@harbor_health path /.harbor/health
		respond @harbor_health 204

		# TRACE and TRACK allow cross-site tracing.
		@trace method TRACE TRACK
		respond @trace 405

		# /.well-known/ is a registered path prefix (RFC 8615), not a hidden
		# file. /.thumbs/ holds the admin media browser thumbnails.
		@hidden {
			path_regexp hidden /\.
			not path /.well-known/*
			not path_regexp thumbs /\.thumbs/
		}
		respond @hidden 404

		# File types that disclose the installation. The exempt names are
		# generated by PHP, so no file exists on disk and the exemption only
		# lets the request reach PHP. The list therefore follows Maho main: a
		# name an older version does not serve just gets a 404 from PHP.
		@private {
			path *.txt *.json *.dist *.flag *.ip *.lock *.md *.neon *.sample *.sh *.yaml *.yml
			not path /robots.txt /llms.txt /llms-full.txt /manifest.json /api/docs.json
			not path /.well-known/mcp.json /.well-known/mcp/server-card.json
		}
		respond @private 404

		# Maho exposes the installer at /install; normalize the trailing slash
		# before the request reaches the PHP handler.
		@install_trailing_slash path /install/
		rewrite @install_trailing_slash /install

		# /api/* entry points, in this order:
		#   /api/rest/v2/*                        -> rest.php  (must precede /api/rest)
		#   /api/rest/*                           -> api.php   (legacy Magento 1 REST)
		#   /api/{soap,v2_soap,xmlrpc,jsonrpc}/*  -> index.php (legacy Mage_Api, excluded below)
		#   everything else under /api/*          -> rest.php  (graphql, mcp, docs)
		#
		# Do not add CORS headers here. Maho answers CORS and the OPTIONS
		# preflight inside the API kernel, configured in
		# System > Configuration > Services > API > CORS Allowed Origins.
		@api_v2 {
			path_regexp api_v2 ^/api/rest/v2(/|$)
			not file
		}
		rewrite @api_v2 /rest.php

		# A rewrite with its own query string replaces the original one, so the
		# placeholder puts it back. This is Apache's [QSA].
		@api_legacy_rest {
			path_regexp api_legacy_rest ^/api/rest(/|$)
			not file
		}
		rewrite @api_legacy_rest /api.php?type=rest&{http.request.uri.query}

		@api_other {
			path_regexp api_other ^/api(/|$)
			not path_regexp api_legacy_rpc ^/api/(soap|v2_soap|xmlrpc|jsonrpc)(/|$)
			not file
		}
		rewrite @api_other /rest.php

		php_server
	}
}

# Site blocks dropped into Caddyfile.d are included, as in the base image.
import Caddyfile.d/*.caddyfile
