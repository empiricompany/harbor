# Harbor Compose scaffold; optional services are selected through HARBOR_PROFILES.
services:
  app:
    image: maho-harbor/${HARBOR_PROJECT_NAME:-harbor}:app-php${HARBOR_PHP_VERSION:-8.4}-trixie
    build:
      context: ../vendor/empiricompany/harbor
      dockerfile: docker/Dockerfile
    depends_on:
      db:
        condition: service_healthy
      mailpit:
        condition: service_started
    ports:
      - "${HARBOR_APP_PORT:-8443}:${HARBOR_APP_PORT:-8443}"
    volumes:
      - ../:/app
    networks: [harbor]
  db:
    image: mysql:8.4
    environment:
      MYSQL_DATABASE: ${HARBOR_DB_NAME}
      MYSQL_USER: ${HARBOR_DB_USER}
      MYSQL_PASSWORD: ${HARBOR_DB_PASSWORD}
      MYSQL_ROOT_PASSWORD: ${HARBOR_DB_ROOT_PASSWORD}
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-p${HARBOR_DB_ROOT_PASSWORD}"]
      interval: 5s
      timeout: 5s
      retries: 20
    ports:
      - "127.0.0.1:${HARBOR_MYSQL_PORT:-3306}:3306"
    volumes:
      - harbor-db-data:/var/lib/mysql
    networks: [harbor]
  mailpit:
    image: axllent/mailpit:v1.21.8
    ports:
      - "${HARBOR_MAILPIT_PORT:-8025}:8025"
      - "${HARBOR_MAILPIT_SMTP_PORT:-1025}:1025"
    networks: [harbor]
  cron:
    image: mcuadros/ofelia:0.3.16
    depends_on:
      app:
        condition: service_started
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks: [harbor]
  redis:
    image: redis:7.4
    profiles: [redis]
    command: redis-server --maxmemory-policy volatile-lfu
    restart: unless-stopped
    tmpfs:
      - /data
    networks: [harbor]
  adminer:
    image: adminer:4
    profiles: [adminer]
    environment:
      ADMINER_DEFAULT_SERVER: db
    ports:
      - "${HARBOR_ADMINER_PORT:-8082}:8080"
    networks: [harbor]
  phpmyadmin:
    image: phpmyadmin:5.2
    profiles: [phpmyadmin]
    environment:
      PMA_HOST: db
      PMA_PORT: 3306
    ports:
      - "${HARBOR_PHPMYADMIN_PORT:-8081}:80"
    networks: [harbor]
volumes:
  harbor-db-data: null
networks:
  harbor:
    driver: bridge
